# 복사해서 .env 로 사용하세요:  cp .env.example .env
# ---- 저장소 (Supabase elenchos 스키마, supabase/migrations/0003_elenchos_store.sql) ----
# 비워 두면 메모리 저장소로 동작 (로컬 개발용, 서버 재시작 시 초기화)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
ELENCHOS_DB_KEY=elenchos.config 의 api_key 와 같은 값

# ---- 세션 ----
# 운영(APP_ENV=production)에서는 필수. 무작위 긴 문자열
SESSION_SECRET=

# ---- AI ----
# claude | openai
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
AI_MAX_TOKENS=4096
# LLM 품질 평가(Ragas) judge 모델. 분석기와 다른 모델 권장
EVAL_JUDGE_MODEL=claude-opus-5-5

# ---- App ----
APP_ENV=development
MAX_ESSAY_CHARS=5000

# ---- 테스트 로그인 (APP_ENV=production 이면 자동 비활성화) ----
ENABLE_TEST_LOGIN=true
TEST_LOGIN_ID=test
TEST_LOGIN_PASSWORD=testpoc
