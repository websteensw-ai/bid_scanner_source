# 복사해서 .env 로 사용하세요:  cp .env.example .env
# ---- Supabase ----
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# 서버 전용(관리 작업). 절대 클라이언트/깃에 노출 금지
SUPABASE_SERVICE_ROLE_KEY=

# ---- AI ----
# claude | openai
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
AI_MAX_TOKENS=4096

# ---- App ----
APP_ENV=development
MAX_ESSAY_CHARS=5000
